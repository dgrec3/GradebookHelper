{
  "manifest_version": 3,
  "name": "Gradebook Enhancer for PowerTeacher Pro",
  "short_name": "Gradebook Enhancer",
  "version": "1.0",
  "description": "Color-code PowerTeacher Pro scoresheet grades with your own thresholds, flag colors and split highlights. Not by PowerSchool.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Gradebook Enhancer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.powerschool.com/teachers/*"
      ],
      "js": [
        "settings.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "https://*.powerschool.com/*"
      ]
    }
  ]
}
