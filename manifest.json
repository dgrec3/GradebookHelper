{
  "manifest_version": 3,
  "name": "PowerTeacher Gradebook - Highlight Low Grades",
  "version": "1.2.1",
  "description": "Highlights low grades in PowerTeacher Pro Gradebook: red below 70%, yellow from 70% through 79.99%.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "*://*.powerschool.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js"
      ],
      "matches": [
        "*://*.powerschool.com/*"
      ]
    }
  ]
}